{
  "name": "codexbar-usage",
  "displayName": "%ext.displayName%",
  "description": "%ext.description%",
  "version": "0.6.0",
  "publisher": "ZanderAlastor",
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "codexbar",
    "openai",
    "quota",
    "usage",
    "deepseek",
    "status bar",
    "remote"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/UFOAlastor/codexbar-usage.git"
  },
  "bugs": {
    "url": "https://github.com/UFOAlastor/codexbar-usage/issues"
  },
  "contributes": {
    "commands": [
      {
        "command": "codexbarUsage.refresh",
        "title": "%cmd.refresh.title%"
      },
      {
        "command": "codexbarUsage.showDetails",
        "title": "%cmd.showDetails.title%"
      },
      {
        "command": "codexbarUsage.openSettings",
        "title": "%cmd.openSettings.title%"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "codexbarUsage.providers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "markdownDescription": "%config.providers.desc%"
        },
        "codexbarUsage.statusBarLimit": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 8,
          "scope": "window",
          "description": "%config.statusBarLimit.desc%"
        },
        "codexbarUsage.metric": {
          "type": "string",
          "enum": [
            "remaining",
            "used"
          ],
          "enumDescriptions": [
            "%config.metric.remaining%",
            "%config.metric.used%"
          ],
          "default": "remaining",
          "scope": "window",
          "description": "%config.metric.desc%"
        },
        "codexbarUsage.showCounters": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "%config.showCounters.desc%"
        },
        "codexbarUsage.inheritCodexBar": {
          "type": "boolean",
          "default": true,
          "scope": "machine-overridable",
          "markdownDescription": "%config.inheritCodexBar.desc%"
        },
        "codexbarUsage.sortOrder": {
          "type": "string",
          "enum": [
            "codexbar",
            "usage",
            "alphabetical"
          ],
          "enumDescriptions": [
            "%config.sortOrder.codexbar%",
            "%config.sortOrder.usage%",
            "%config.sortOrder.alphabetical%"
          ],
          "default": "codexbar",
          "scope": "window",
          "description": "%config.sortOrder.desc%"
        },
        "codexbarUsage.hiddenProviders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "markdownDescription": "%config.hiddenProviders.desc%"
        },
        "codexbarUsage.refreshMode": {
          "type": "string",
          "enum": [
            "adaptive",
            "fixed",
            "off"
          ],
          "enumDescriptions": [
            "%config.refreshMode.adaptive%",
            "%config.refreshMode.fixed%",
            "%config.refreshMode.off%"
          ],
          "default": "adaptive",
          "scope": "window",
          "description": "%config.refreshMode.desc%"
        },
        "codexbarUsage.refreshMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "scope": "window",
          "description": "%config.refreshMinutes.desc%"
        },
        "codexbarUsage.refreshOnFocus": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%config.refreshOnFocus.desc%"
        },
        "codexbarUsage.warnThreshold": {
          "type": "number",
          "default": 80,
          "scope": "window",
          "description": "%config.warnThreshold.desc%"
        },
        "codexbarUsage.errorThreshold": {
          "type": "number",
          "default": 95,
          "scope": "window",
          "description": "%config.errorThreshold.desc%"
        },
        "codexbarUsage.executable": {
          "type": "string",
          "default": "codexbar",
          "scope": "machine-overridable",
          "description": "%config.executable.desc%"
        },
        "codexbarUsage.extraPath": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "/opt/homebrew/bin",
            "/usr/local/bin"
          ],
          "scope": "machine-overridable",
          "description": "%config.extraPath.desc%"
        }
      }
    }
  },
  "l10n": "./l10n"
}
